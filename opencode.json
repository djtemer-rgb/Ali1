{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen/qwen3-coder:free",
  "small_model": "openrouter/qwen/qwen3-coder:free",
  "instructions": [
    "AGENTS.md",
    "docs/ALI_QUEST_PRODUCT_BRIEF.md",
    "skills/socraticode/SKILL.md",
    "skills/socraticode/workflow.md"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "socraticode": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "socraticode"
      ],
      "enabled": true,
      "timeout": 20000
    }
  }
}
